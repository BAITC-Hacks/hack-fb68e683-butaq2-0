# --- OpenAI ---------------------------------------------------------------
TELEPHONY_OPENAI_API_KEY=sk-...
TELEPHONY_OPENAI_WEBHOOK_SECRET=whsec_...
TELEPHONY_OPENAI_PROJECT_ID=proj_...
TELEPHONY_LIVE_MODEL=gpt-live-1
TELEPHONY_VOICE=marin
TELEPHONY_BACKEND_MODEL=gpt-5.6-luna

# --- Twilio ---------------------------------------------------------------
TELEPHONY_TWILIO_ACCOUNT_SID=AC...
TELEPHONY_TWILIO_AUTH_TOKEN=...
TELEPHONY_TWILIO_FROM_NUMBER=+15550001111
# Public HTTPS base Twilio calls back on. The signature is checked against
# this exact URL, so it must match what Twilio requests (tunnel/proxy aware).
TELEPHONY_PUBLIC_BASE_URL=https://your-tunnel.example.com

# --- infrastructure (optional until the Redis/Postgres profiles land) -----
# TELEPHONY_REDIS_URL=redis://localhost:6379/0
# TELEPHONY_DATABASE_URL=postgresql+asyncpg://telephony:telephony@localhost/telephony

# --- limits & policy ------------------------------------------------------
TELEPHONY_MAX_CONCURRENT_CALLS=50
TELEPHONY_MAX_CALL_SECONDS=1800
TELEPHONY_ALLOWED_TRANSFER_PREFIXES=["+1555"]
TELEPHONY_ALLOWED_SIP_DOMAINS=["support.example.com"]

# --- privacy ---------------------------------------------------------------
# Transcripts and audio are never stored, so there is nothing to switch off.
# Spoken on the Twilio leg only; for direct SIP calls put the disclosure in
# TELEPHONY_INSTRUCTIONS instead. Leave empty to say nothing.
TELEPHONY_DISCLOSURE=This call is handled by an AI assistant.
