# Butaq Voice Router — copy to .env and replace the example secrets.
# Docker Compose loads this file into the backend. Restart the backend after edits:
# docker compose up -d --build backend
# For local browser development use localhost:3000; for owlpeer.com set the
# public origin below to https://owlpeer.com before registering a passkey.

# --- Required: API access and PostgreSQL ------------------------------------
V2V_API_KEY=sk-your-openai-api-key
ROUTER_ADMIN_TOKEN=replace-with-a-long-random-token
POSTGRES_PASSWORD=butaq-local
# Compose constructs DATABASE_URL from POSTGRES_PASSWORD; do not set it here for
# Compose. Standalone uvicorn/Alembic may use DATABASE_URL in the shell instead.

# --- Browser and admin authentication ---------------------------------------
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ROUTER_WEBAUTHN_ORIGIN=http://localhost:3000
# Production example: ROUTER_WEBAUTHN_ORIGIN=https://owlpeer.com
# Must match the exact URL used for passkeys and admin cookie-protected edits.

# --- Router: scenario selection and response generation --------------------
# These two values seed an EMPTY router_settings table only. On an existing
# installation, use /admin/settings/ (or PATCH /router/admin/settings) to change
# the live model or threshold; the database takes precedence over these defaults.
ROUTER_MODEL=gpt-4o-mini
ROUTER_CONFIDENCE_THRESHOLD=0.65
# Routing and answer prompts are also live database settings edited in /admin/settings/.

# --- V2V: shared OpenAI connection -----------------------------------------
# V2V_API_KEY above is used for transcription, routing, answers and speech.
# V2V_BASE_URL=https://api.openai.com/v1
V2V_REQUEST_TIMEOUT=120
V2V_MAX_RETRIES=2

# --- V2V: the /router/voice transcribe -> route -> speak pipeline ----------
V2V_TRANSCRIBE_MODEL=gpt-transcribe
# Leave language auto-detected for Russian/Kazakh code-switching.
# V2V_TRANSCRIBE_LANGUAGE=ru
V2V_TTS_MODEL=gpt-4o-mini-tts
V2V_TTS_VOICE=marin
V2V_TTS_FORMAT=mp3
# V2V_TTS_INSTRUCTIONS=Speak warmly and clearly.
V2V_MAX_UPLOAD_BYTES=26214400
# Used by the standalone v2v pipeline, not by the Router's LLM calls:
V2V_TEXT_MODEL=gpt-5.6-terra
V2V_MAX_HISTORY_TURNS=20

# --- V2V: standalone realtime/WebRTC library settings ----------------------
# The current /router/voice endpoint is turn-based; these apply only if the
# separate v2v realtime router is mounted by another app.
V2V_REALTIME_MODEL=gpt-realtime-2.1
V2V_VOICE=marin
V2V_INSTRUCTIONS=You are a helpful voice assistant. Speak the user's language.
V2V_INPUT_CODEC=audio/pcm
V2V_INPUT_SAMPLE_RATE=24000
V2V_OUTPUT_CODEC=audio/pcm
V2V_OUTPUT_SAMPLE_RATE=24000
V2V_TURN_DETECTION=semantic_vad
# Used only for V2V_TURN_DETECTION=server_vad:
V2V_VAD_SILENCE_MS=500
V2V_VAD_THRESHOLD=0.5
V2V_VAD_PREFIX_PADDING_MS=300
V2V_INPUT_TRANSCRIPTION_MODEL=gpt-transcribe
V2V_OUTPUT_MODALITIES=["audio"]
V2V_MAX_TOOL_ROUNDS=8
V2V_ALLOW_CLIENT_SESSION_UPDATE=false
V2V_CLIENT_SECRET_TTL_SECONDS=600
# Only used if the separate v2v router is mounted:
# V2V_API_PREFIX=/v2v
# V2V_API_TAG=v2v

# --- Multi-agent Router + Resolution ----------------------------------------
# External SDK tracing is opt-in; resolution turns include bounded tool calls.
MULTI_AGENT_TIMEOUT_SECONDS=20
MULTI_AGENT_RESOLUTION_MAX_TURNS=3
MULTI_AGENT_TRACING=false

# --- Face ID: local face recognition ----------------------------------------
# InsightFace runs locally. The first face request downloads its model pack.
FACEID_BACKEND=insightface
FACEID_INSIGHTFACE_MODEL=buffalo_l
FACEID_INSIGHTFACE_PROVIDERS=["CPUExecutionProvider"]
FACEID_DETECTION_SIZE=640
FACEID_MIN_DETECTION_SCORE=0.5
FACEID_MATCH_THRESHOLD=0.42
FACEID_MIN_INPUT_SIDE=320
FACEID_MAX_UPSCALE=4.0
FACEID_PAD_RETRY=true
FACEID_PAD_RATIO=1.0
FACEID_MAX_IMAGE_BYTES=8388608
# Dlib requires installing the optional face_recognition backend separately:
# FACEID_BACKEND=face_recognition
# FACEID_DLIB_DETECTOR=hog

# --- Face ID: optional OpenAI capture/anti-spoof assist --------------------
# Enable only after setting FACEID_API_KEY (or OPENAI_API_KEY).
FACEID_OPENAI_ASSIST=false
# FACEID_API_KEY=sk-your-openai-api-key
# FACEID_BASE_URL=https://api.openai.com/v1
FACEID_VISION_MODEL=gpt-5.6-terra
FACEID_SCREENING_MODEL=gpt-5.6-luna
FACEID_IMAGE_DETAIL=high
FACEID_LIVENESS_THRESHOLD=0.70
FACEID_QUALITY_THRESHOLD=0.55
FACEID_REQUEST_TIMEOUT=60
FACEID_MAX_RETRIES=2

# --- Face ID: standalone package settings ----------------------------------
# Admin face templates always use the Router PostgreSQL database, require one
# face per image and never store reference photos. Those choices are enforced
# in app/api/admin_auth.py; FACEID_DB_URL, FACEID_MULTI_FACE_POLICY and
# FACEID_STORE_REFERENCE_IMAGES do not override admin authentication.
# FACEID_MULTI_FACE_POLICY=reject
# FACEID_DB_URL=postgresql+asyncpg://user:password@host:5432/faceid
# FACEID_STORE_PATH=/path/to/faceid.json
# FACEID_STORE_REFERENCE_IMAGES=false
FACEID_DB_TABLE_PREFIX=faceid_
FACEID_DB_CREATE_SCHEMA=true
FACEID_DB_ECHO=false
FACEID_MAX_IDENTIFY_RESULTS=10
# The generic /faceid router is not mounted in this app:
# FACEID_API_PREFIX=/faceid
# FACEID_API_TAG=faceid
